# External Fastify API — server-only, used by the Route Handler proxy at /api/*
API_UPSTREAM_URL="https://dev-iron-blue-ldpia6skza-lm.a.run.app"

# Optional: only set when the client must call an absolute API origin (e.g. SSR).
