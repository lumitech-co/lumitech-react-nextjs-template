{
  "name": "lumitech-react-nextjs-template",
  "private": true,
  "version": "0.0.0",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "commit": "cz",
    "build": "next build",
    "dev": "next dev",
    "start": "next start",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "typescript": "tsc --noEmit",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --report-unused-disable-directives --max-warnings 0 --fix",
    "lint:staged": "lint-staged",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate:entity": "node cli/entity-gen/index.js",
    "generate:feature": "node cli/feature-gen/index.js",
    "knip": "knip --treat-config-hints-as-errors",
    "check:generators": "node scripts/check-generators.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "next analyze"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,mjs,json,md,yml,yaml,css}": "prettier --write --ignore-unknown"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.68.0",
    "@tanstack/react-query-devtools": "^5.68.0",
    "axios": "^1.21.0",
    "clsx": "^2.1.0",
    "jiti": "^2.7.0",
    "next": "16.4.5",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "nuqs": "2.10.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.2.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^17.7.0",
    "@eslint/js": "^9",
    "@ianvs/prettier-plugin-sort-imports": "^4.1.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@playwright/test": "^1.63.0",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/eslint-plugin-query": "^5.104.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.27",
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^3.8.3",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-react": "^7.33.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "^17.14.0",
    "husky": "^9.1.1",
    "jsdom": "^26",
    "knip": "^6.44.1",
    "lint-staged": "^15.2.7",
    "msw": "^2.15.0",
    "postcss": "^8.5.18",
    "prettier": "^3.0.1",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "tailwindcss": "^3.0.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "resolutions": {
    "source-map-js": "^1.2.2"
  },
  "packageManager": "yarn@1.22.22"
}
